APP_ENV=development
DATABASE_URL=sqlite:///./pharma.db
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Used by scripts/backup.py and scripts/restore.py to encrypt/decrypt
# local backups. Leave unset in development; backups will be written
# unencrypted with a loud warning. Set a real random value before
# treating backups as suitable for offline storage.
BACKUP_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
